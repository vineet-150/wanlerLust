    <% layout("/layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <h2 class="col-6 offset-3">SignUp on WanderLust</h2>
        <div class="col-6 offset-3">
            
            <form action="/signup" method="pOST" class="needs-validation" novalidate>

                  <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input name="username" placeholder="Enter a Username " type="text" class="form-control"
                        required id="username">
                        <div class="valid-feedback"> looks good!</div>
                   </div>

                     <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input name="email" placeholder="Enter a Email" type="text" class="form-control"
                        required id="email">
                       
                   </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input name="password" placeholder="Enter a Password" type="text" class="form-control"
                        required id="password">
                       
                   </div>


                   <button class="btn btn-success">SignUp</button>


            </form>
        </div>
    </div>