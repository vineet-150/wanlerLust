
    <% layout("/layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>Edit Your Listing </h3>

    <form action="/listings/<%=listing._id%>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">


        <div class="mb-3">
        <label for="title" class="form-lable">Title</label>
        <input name="listing[title]" value="<%=listing.title%>" type="text" class="form-control" required>
          <div class="valid-feedback">Title looks good!</div>
        </div>


        <div class="mb-3">      
         
         <label for="description" class="form-lable">Description</label>
       <textarea  class="form-control"
    name="listing[description]" required
><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a Short Description</div>
       </div>
        

        <div class="mb-3">

        Original Listing Image <br>
        <img src="<%=originalImageUrl%>" alt=""
          style="height: 200px; width: 250px; object-fit: cover; border-radius: 5px;">

        </div>
        <div class="mb-3">
       <label for="image" class="form-lable">Upload new Image</label>   
        <input class="form-control" name="listing[image]"  type="file">
        </div>


        <div class="row">

            
             <div class="mb-3 col-md-4">
             <label for="price" class="form-lable">Price</label>
             <input required class="form-control" name="listing[price]" value="<%=listing.price%>" type="number">
             <div class="invalid-feedback">Please enter a valid Price</div>
        </div>


        <div class="mb-3 col-md-8">
              <label  for="country" class="form-lable">Country</label>
              <input required class="form-control" name="listing[country]" value="<%=listing.country%>" type="text">
               <div class="invalid-feedback">Country Should Be Valid</div>
        </div>


        </div>
        

        <div class="mb-3">

             <label for="location" class="form-lable">Location</label>

             <input required class="form-control" name="listing[location]" value="<%=listing.location%>" type="text">
              <div class="invalid-feedback">Location Should Be Valid</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button>
        <br/><br/>


    </form>
    </div>
</div>

